# Infrastructure credentials — SSH / SSHFS / WireGuard / Termux
# These are system-level files, not env vars. Listed here for documentation only.
#
# SSHFS : /etc/opt-trading/shared_sshfs_permanent.env
#   IDENTITY_FILE=/home/<user>/.ssh/id_ed25519
#
# WireGuard : /etc/wireguard/wg0.conf (generated by wg genkey, never in git)
#   WG_PRIVATE_KEY=<generated>
#
# Termux SSH : ~/.ssh/id_ed25519_termux (generated by termux_operator bootstrap.sh)
#   Authorized via ~/.ssh/authorized_keys on target machine
