# Bitget credentials — local file (NOT versioned)
# Copy this file to bitget.env and fill in real values.
# Format: KEY=VALUE (one per line, # for comments)

# Profile: readonly_main
BITGET_READONLY_MAIN_API_KEY=your_api_key_here
BITGET_READONLY_MAIN_SECRET_KEY=your_secret_key_here
BITGET_READONLY_MAIN_PASSPHRASE=your_passphrase_here
