{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebhookEvent v1",
  "description": "Contrat réel du payload écrit dans events.jsonl par webhook_server.py",
  "type": "object",
  "required": [
    "engine",
    "signal",
    "symbol",
    "tf",
    "price",
    "tp",
    "sl",
    "reason",
    "_ts",
    "qty"
  ],
  "properties": {
    "key": {
      "type": ["string", "null"]
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "signal": {
      "type": "string",
      "enum": ["BUY", "SELL"]
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "tf": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "tp": {
      "type": "number"
    },
    "sl": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "_ts": {
      "type": "string"
    },
    "_ip": {
      "type": ["string", "null"]
    },
    "qty": {
      "type": "number"
    },
    "risk_usd": {
      "type": ["number", "null"]
    },
    "risk_real_usd": {
      "type": ["number", "null"]
    }
  },
  "additionalProperties": true
}
