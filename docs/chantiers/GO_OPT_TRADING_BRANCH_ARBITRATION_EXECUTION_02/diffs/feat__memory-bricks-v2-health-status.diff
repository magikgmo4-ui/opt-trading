+        f"# {brick.id} ÔÇö {brick.title}\n\n"
+        f"## R├®sum├® court\n{brick.summary_short}\n\n"
+        f"## D├®cisions\n{decisions_md}\n\n"
+        f"## TODO\n{todo_md}\n\n"
+        f"## Reprise\n{brick.resume_point}\n\n"
+        f"## Liens\n{links_md}\n"
+    )
