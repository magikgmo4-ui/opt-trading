@@ -0,0 +1,10 @@
+from __future__ import annotations
+
+import re
+
+
+def slugify(text: str) -> str:
+    slug = text.lower().strip()
+    slug = re.sub(r"[^a-z0-9]+", "-", slug)
+    slug = re.sub(r"-{2,}", "-", slug).strip("-")
+    return slug or "untitled"
