+RED='\033[0;31m'
+GRN='\033[0;32m'
+YEL='\033[1;33m'
+BLU='\033[0;34m'
+CYA='\033[0;36m'
+RST='\033[0m'
+
+OK="${GRN}[OK]${RST}"
