new file mode 100644
index 0000000..62ed078
--- /dev/null
+++ b/modules/journal_api_extractor/app/stores/jsonl_store.py
@@ -0,0 +1,48 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from app.errors import ValidationError
+
+REQUIRED_ENTRY_KEYS = (
+    "entry_id",
+    "session_id",
+    "message_index",
+    "speaker",
+    "content_raw",
+    "created_at",
+    "source_kind",
+)
+
+
+def load_jsonl_entries(path: Path) -> list[dict]:
+    if not path.exists():
+        raise ValidationError(f"Input file not found: {path}")
+
+    entries: list[dict] = []
+    with path.open("r", encoding="utf-8") as handle:
+        for line_number, raw_line in enumerate(handle, start=1):
+            line = raw_line.strip()
+            if not line:
+                continue
+            try:
+                entry = json.loads(line)
+            except json.JSONDecodeError as exc:
+                raise ValidationError(
+                    f"Invalid JSONL at line {line_number}: {exc.msg}"
+                ) from exc
+            _validate_entry(entry, line_number)
+            entries.append(entry)
+
+    if not entries:
+        raise ValidationError(f"No entries found in input file: {path}")
+    return entries
+
+
+def _validate_entry(entry: dict, line_number: int) -> None:
+    missing_keys = [key for key in REQUIRED_ENTRY_KEYS if key not in entry]
+    if missing_keys:
+        raise ValidationError(
+            f"Missing keys at line {line_number}: {', '.join(missing_keys)}"
+        )
diff --git a/modules/journal_api_extractor/app/stores/output_store.py b/modules/journal_api_extractor/app/stores/output_store.py
new file mode 100644
index 0000000..c4e17df
--- /dev/null
