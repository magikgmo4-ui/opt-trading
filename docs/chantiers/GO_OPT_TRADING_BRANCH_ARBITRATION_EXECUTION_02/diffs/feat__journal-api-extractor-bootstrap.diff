@@ -0,0 +1,42 @@
+from __future__ import annotations
+
+from pathlib import Path
+
+from app.constants import (
+    FIELDS_VERSION,
+    FULL_OUTPUT_NAME,
+    PIPELINE_VERSION,
+    RULES_VERSION,
+    SCHEMA_VERSION,
+)
+from app.stores.jsonl_store import load_jsonl_entries
+from app.stores.output_store import write_json_output
+
+
+def run_full_command(config, input_path: Path) -> int:
+    resolved_input = _resolve_input_path(config.module_root, input_path)
+    entries = load_jsonl_entries(resolved_input)
+    output_path = config.output_dir / FULL_OUTPUT_NAME
+
+    report = {
+        "entry_count": len(entries),
+        "input_path": str(resolved_input),
+        "output_path": str(output_path),
+        "schema_version": SCHEMA_VERSION,
+        "rules_version": RULES_VERSION,
+        "fields_version": FIELDS_VERSION,
+        "pipeline_version": PIPELINE_VERSION,
+    }
+    write_json_output(output_path, report)
+
+    print("PASS full")
+    print(f"entries_read={report['entry_count']}")
+    print(f"input_path={report['input_path']}")
+    print(f"output_path={report['output_path']}")
+    return 0
+
+
+def _resolve_input_path(module_root: Path, input_path: Path) -> Path:
+    if input_path.is_absolute():
+        return input_path
+    return (module_root / input_path).resolve()
diff --git a/modules/journal_api_extractor/app/cli/commands_validate.py b/modules/journal_api_extractor/app/cli/commands_validate.py
new file mode 100644
index 0000000..cae6312
--- /dev/null
+++ b/modules/journal_api_extractor/app/cli/commands_validate.py
@@ -0,0 +1,60 @@
+from __future__ import annotations
+
+from pathlib import Path
+
+from app.constants import REQUIRED_PATHS, SAMPLE_INPUT_RELATIVE, SANITY_OUTPUT_NAME
+from app.errors import ValidationError
+from app.stores.jsonl_store import load_jsonl_entries
+from app.stores.output_store import write_json_output
+
+
+def run_sanity_command(config) -> int:
+    try:
+        _check_required_paths(config.module_root)
+        sample_path = (config.module_root / SAMPLE_INPUT_RELATIVE).resolve()
+        entries = load_jsonl_entries(sample_path)
+        output_path = config.output_dir / SANITY_OUTPUT_NAME
+        write_json_output(
+            output_path,
+            {
+                "status": "PASS",
+                "checked_entries": len(entries),
+                "sample_path": str(sample_path),
+                "output_path": str(output_path),
+            },
+        )
+    except Exception as exc:  # pragma: no cover - CLI guard
+        print(f"FAIL sanity: {exc}")
+        return 1
+
+    print("PASS sanity")
+    print(f"entries_checked={len(entries)}")
+    print(f"output_path={output_path}")
+    return 0
+
+
+def run_validate_command(config) -> int:
+    try:
+        _check_required_paths(config.module_root)
+        sample_path = (config.module_root / SAMPLE_INPUT_RELATIVE).resolve()
+        entries = load_jsonl_entries(sample_path)
+        if not entries:
+            raise ValidationError("Sample JSONL is empty")
+    except Exception as exc:  # pragma: no cover - CLI guard
+        print(f"FAIL validate: {exc}")
+        return 1
+
+    print("PASS validate")
+    print(f"required_paths={len(REQUIRED_PATHS)}")
+    print(f"sample_entries={len(entries)}")
+    return 0
+
+
+def _check_required_paths(module_root: Path) -> None:
+    missing = []
+    for relative_path in REQUIRED_PATHS:
+        candidate = module_root / relative_path
+        if not candidate.exists():
+            missing.append(relative_path)
+    if missing:
+        raise ValidationError(f"Missing required paths: {', '.join(missing)}")
diff --git a/modules/journal_api_extractor/app/cli/main.py b/modules/journal_api_extractor/app/cli/main.py
