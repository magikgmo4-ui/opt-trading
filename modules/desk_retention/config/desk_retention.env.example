# desk_retention.env (copy -> modules/desk_retention/config/desk_retention.env)

KEEP_DAYS=7
PRUNE_EMPTY_DIRS=1

PRUNE_PATHS="/opt/trading/desk/snapshots /srv/sftp/shared_files/shared/inbox /srv/sftp/shared_files/shared/vision_processed /srv/sftp/shared_files/shared/vision_outbox /opt/trading/_work/bot_vision_step2"

# optional regex to exclude
EXCLUDE_REGEX="latest\.json$|history\.jsonl$|\.keep$"

LOG_DIR="/opt/trading/journal/tmp"
