# Derivatives Collector Configuration

# Data Source: mock, coinglass, binance, bitget
DATA_SOURCE=mock

# Symbols to monitor (comma-separated)
SYMBOLS=BTCUSDT,ETHUSDT

# Output Format: json, csv
OUTPUT_FORMAT=json

# Output Directory (relative to project root)
OUTPUT_DIR=data/derivatives

# API Keys (Placeholders)
# COINGLASS_API_KEY=
# BITGET_API_KEY=
# BINANCE_API_KEY=

# Mock Data Settings (for testing)
MOCK_OI_RANGE=10000000-50000000
MOCK_FUNDING_RANGE=-0.01-0.05
