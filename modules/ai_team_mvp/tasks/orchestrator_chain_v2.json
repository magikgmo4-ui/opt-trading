{
  "task_id": "orchestrator_chain_v2_01",
  "task_type": "ORCHESTRATOR_CHAIN",
  "worker": "orchestrator",
  "model": "opencode-go/deepseek-v4-pro",
  "description": "Chaine MVP v2 : READ_INVENTORY → ANALYZE_INVENTORY → DOC_DRAFT. 3 etapes sequentielles, arret au premier echec, aucune ecriture git.",
  "task_scope": {
    "operations": ["chain_execute"],
    "output_dir": "modules/ai_team_mvp/drafts/"
  },
  "security": {
    "no_secrets": true,
    "no_env_files": true,
    "no_git_write_ops": true,
    "no_runtime_write_by_default": true,
    "requires_external_validation": true,
    "output_status": "DRAFT_ONLY",
    "only_verified_models": true,
    "write_target": "modules/ai_team_mvp/drafts/",
    "denied_inputs": [
      ".env", "**/.env", "**/*secret*", "**/*token*", "**/*credential*",
      "**/id_rsa", "**/id_ed25519", "**/*.pem", "**/*.key"
    ],
    "denied_commands": [
      "git add", "git commit", "git push", "git rebase", "git merge",
      "rm -rf", "chmod -R", "chown -R"
    ]
  },
  "required_sections": [
    "13_ESTABLISHED",
    "14_HYPOTHESIS",
    "15_REMAINING_GAP",
    "16_TODO",
    "VERDICT_DRAFT_ONLY"
  ],
  "chain": [
    {
      "step": 1,
      "task_packet": "modules/ai_team_mvp/tasks/read_inventory.json",
      "worker": "observer",
      "output_tag": "observer",
      "description": "READ_INVENTORY : scanner docs/chantiers/ et GO_INDEX.md"
    },
    {
      "step": 2,
      "task_packet": "modules/ai_team_mvp/tasks/analyze_inventory.json",
      "worker": "analyzer",
      "output_tag": "analyzer",
      "description": "ANALYZE_INVENTORY : classifier et analyser la sortie Observer"
    },
    {
      "step": 3,
      "task_packet": "modules/ai_team_mvp/tasks/observer_doc_draft.json",
      "worker": "documenter",
      "output_tag": "doc",
      "description": "DOC_DRAFT : produire un brouillon documentaire final"
    }
  ],
  "smoke": {
    "required": true,
    "type": "ORCHESTRATOR_CHAIN",
    "criteria": [
      "chain_executes_completely",
      "all_3_steps_exit_zero",
      "intermediate_files_produced",
      "final_draft_produced",
      "no_git_write_ops",
      "no_denied_inputs",
      "no_write_outside_drafts_dir"
    ]
  }
}
