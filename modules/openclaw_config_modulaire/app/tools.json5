{
  profile: "coding",

  deny: [
    "group:runtime",
    "browser",
    "canvas",
    "nodes",
    "cron",
    "gateway",
  ],

  loopDetection: {
    enabled: true,
    historySize: 30,
    warningThreshold: 10,
    criticalThreshold: 20,
    globalCircuitBreakerThreshold: 30,
    detectors: {
      genericRepeat: true,
      knownPollNoProgress: true,
      pingPong: true,
    },
  },

  elevated: {
    enabled: false,
  },
}
