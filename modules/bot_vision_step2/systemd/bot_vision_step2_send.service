[Unit]
Description=bot_vision_step2 scheduled send_latest to Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ghost
Group=ghost
WorkingDirectory=/opt/trading
EnvironmentFile=/opt/trading/modules/bot_vision_step2/config/bot_vision.env
ExecStart=/opt/trading/.venvs/bot_vision_step2/bin/python /opt/trading/modules/bot_vision_step2/app/bot_vision_step2.py send_latest
