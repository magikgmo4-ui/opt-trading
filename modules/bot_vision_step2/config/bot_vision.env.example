# bot_vision_step2 env (copy to bot_vision.env)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=REPLACE_ME
# If empty, bot replies to chat that issued /analyze.
TELEGRAM_CHAT_ID=

# --- OpenAI ---
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-4.1-mini

# --- Paths ---
VISION_INBOX=/srv/sftp/shared_files/shared/vision_inbox
VISION_PROCESSED=/srv/sftp/shared_files/shared/vision_processed
VISION_OUTBOX=/srv/sftp/shared_files/shared/vision_outbox

DESKPRO_VISION_DIR=/opt/trading/data/desk_pro/vision
WORKDIR=/opt/trading/_work/bot_vision_step2

# --- Screenshot handling ---
# Resize before sending to Telegram / OpenAI
MAX_W=1280
MAX_H=720
JPEG_QUALITY=75

# Quadrant cropping (assumes 2x2 layout in one screenshot)
# If your layout is not 2x2, set CROP_MODE=off.
CROP_MODE=quad   # quad | off

# OpenAI analyze mode:
#  single = send ONE resized screenshot (cheapest)
#  quad   = send 4 cropped charts (more detail, more cost)
ANALYZE_MODE=single

# --- Scheduling on admin-trading ---
# If you still run Windows NSSM bot for 10-min posting, keep ENABLE_SENDER_TIMER=0
ENABLE_SENDER_TIMER=0
SENDER_EVERY_MIN=10

# Retention (admin-trading disk cleanup)
ENABLE_PRUNE_TIMER=1
PRUNE_KEEP_DAYS=7
