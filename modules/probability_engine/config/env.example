# Probability Engine Configuration

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Output Directory for exports
OUTPUT_DIR=data/probability

# Weighting Configuration (Default Weights)
# Sum should ideally be close to 1.0, but engine will normalize.
WEIGHT_TREND=0.3
WEIGHT_MOMENTUM=0.2
WEIGHT_OPEN_INTEREST=0.1
WEIGHT_FUNDING=0.1
WEIGHT_LIQUIDATION=0.1
WEIGHT_LIQUIDITY=0.1
WEIGHT_REGIME=0.1

# Thresholds
CONFIDENCE_THRESHOLD_HIGH=0.7
CONFIDENCE_THRESHOLD_MEDIUM=0.5
