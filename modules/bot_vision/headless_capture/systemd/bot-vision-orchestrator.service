[Unit]
Description=Bot Vision Orchestrator — schedule + capture + analyze + publish
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/trading
ExecStart=/bin/bash /opt/trading/modules/bot_vision/headless_capture/scripts/run_orchestrator.sh
User=ghost
Group=ghost
Nice=5
IOSchedulingClass=best-effort
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
