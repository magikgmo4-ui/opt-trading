      "input_family": "coinglass_panel",
      "analyze_template": "coinglass_metrics",
      "analysis_mode": "ocr",
      "analyzer": "coinglass_ocr_analyzer (A-07)",
      "capture_profile": "profiles.coinglass.json",
      "telegram_policy": "send_if_critical"
    },
    {
      "id": "FUNDING_COINGLASS",
