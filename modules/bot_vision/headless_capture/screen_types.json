{
  "$schema": "screen_types.v1",
  "title": "bot_vision screen type registry",
  "version": "1.0.0",
  "screen_types": [
    {
      "id": "CHART_TECHNICAL",
      "label": "Chart technique",
      "description": "Single TradingView chart with technical indicators",
      "source": "tradingview",
      "layout": "single",
      "input_family": "single_chart",
      "analyze_template": "single_chart",
      "analysis_mode": "full",
      "analyzer": "bot_vision_step2",
      "capture_profile": "profiles.production.json",
      "telegram_policy": "send_if_high_confidence"
    },
    {
      "id": "DASHBOARD_MACRO",
      "label": "Dashboard macro 2x2",
      "description": "Quad-slot macro dashboard composed from 4 individual captures",
      "source": "tradingview",
      "layout": "quad",
      "input_family": "dashboard_quad",
      "analyze_template": "dashboard_quad",
      "analysis_mode": "quad",
      "analyzer": "bot_vision_step2 + compose_quad",
      "capture_profile": "profiles.macro_dashboard.json",
      "telegram_policy": "send_if_high_confidence"
    },
    {
      "id": "LIQUIDITY_COINGLASS",
