    {
      "id": "LS_RATIO_COINGLASS",
      "label": "Long/Short ratio Coinglass",
      "description": "Coinglass long/short ratio by exchange",
      "source": "coinglass",
      "layout": "single",
      "input_family": "coinglass_panel",
      "analyze_template": "coinglass_metrics",
