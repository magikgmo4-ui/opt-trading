#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MOD_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$(cd "$MOD_DIR/../.." && pwd)"
HEALTH="$SCRIPT_DIR/health-check"

STATE_DIR="${HEALTH_STATE_DIR:-$REPO_ROOT/_work/health}"
ALERT_COOLDOWN_SEC="${HEALTH_ALERT_COOLDOWN:-1800}"     # 30 min
DOWN_THRESHOLD_SEC="${HEALTH_DOWN_THRESHOLD:-300}"       # 5 min
mkdir -p "$STATE_DIR"

now_epoch() { date +%s; }

# --- state helpers -----------------------------------------------------------

read_state() {
  local surface="$1"
  local state_file="$STATE_DIR/${surface}.state"
  if [[ -f "$state_file" ]]; then
    source "$state_file" 2>/dev/null || true
  fi
  # defaults
  : "${first_seen:=0}" "${last_alert:=0}" "${prev_status:=healthy}"
}

write_state() {
  local surface="$1"
  local state_file="$STATE_DIR/${surface}.state"
  cat >"$state_file" <<EOF
first_seen=${2:-0}
last_alert=${3:-0}
prev_status=${4:-healthy}
EOF
}

# --- Telegram ----------------------------------------------------------------

send_telegram() {
  local text="$1"
  python3 "$REPO_ROOT/shared/telegram_send_cli.py" "alerts" "$text" 2>/dev/null
}

# --- main --------------------------------------------------------------------

main() {
  local now
  now="$(now_epoch)"
  local report
  report="$("$HEALTH" --json 2>/dev/null || echo '[]')"

  # Write surface/status pairs to a temp file to avoid subshell issues
  local tmpfile
  tmpfile="$(mktemp)"
  printf '%s' "$report" | python3 -c "
import sys, json
for s in json.load(sys.stdin):
    print(s['surface'], s['status'])
" >"$tmpfile" 2>/dev/null || true

  local alerts=()
  local changed=0

  while IFS=' ' read -r sid status; do
    [[ -z "$sid" ]] && continue

    first_seen=0; last_alert=0; prev_status=healthy
    read_state "$sid"

    if [[ "$status" == "down" || "$status" == "degraded" ]]; then
      if [[ "$prev_status" == "healthy" ]]; then
        first_seen=$now
        last_alert=0
      fi
      local elapsed=$((now - first_seen))
      local cooldown=$((now - last_alert))

      write_state "$sid" "$first_seen" "$last_alert" "$status"

      if [[ $elapsed -ge $DOWN_THRESHOLD_SEC && $cooldown -ge $ALERT_COOLDOWN_SEC ]]; then
        local mins=$((elapsed / 60))
        alerts+=("🔴 $sid DOWN depuis ${mins} min")
        last_alert=$now
        write_state "$sid" "$first_seen" "$last_alert" "$status"
        changed=1
      fi
    else
      if [[ "$prev_status" != "healthy" ]]; then
        alerts+=("🟢 $sid RECOVERED")
        changed=1
      fi
      write_state "$sid" "0" "$now" "$status"
    fi
  done <"$tmpfile"
  rm -f "$tmpfile"

  # send consolidated alert
  if [[ $changed -eq 1 && ${#alerts[@]} -gt 0 ]]; then
    local msg
    msg="=== Health $(date -u +%H:%MZ) ===
$(printf '%s\n' "${alerts[@]}")"
    send_telegram "$msg" || true
  fi
}

main "$@"
