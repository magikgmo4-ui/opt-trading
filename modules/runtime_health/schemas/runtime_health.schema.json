{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "opt-trading/runtime_health/latest.json",
  "title": "RuntimeHealthReport",
  "description": "Schema for opt-trading Runtime Health Supervisor latest.json output",
  "type": "object",
  "required": [
    "timestamp",
    "hostname",
    "machine",
    "run_id",
    "overall_status",
    "block_statuses",
    "advisory_summary",
    "checks",
    "elapsed_seconds"
  ],
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp of the run"
    },
    "hostname": {
      "type": "string",
      "description": "Hostname of the machine running the check"
    },
    "machine": {
      "type": "string",
      "description": "Canonical machine name from machine_runtime_map.yml"
    },
    "run_id": {
      "type": "string",
      "description": "UUID v4 uniquely identifying this run"
    },
    "overall_status": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"],
      "description": "Operational aggregate status: FAIL/WARN only for non-advisory checks"
    },
    "block_statuses": {
      "type": "object",
      "description": "Per-block aggregate statuses",
      "additionalProperties": {
        "type": "string",
        "enum": ["PASS", "WARN", "FAIL"]
      }
    },
    "advisory_summary": {
      "type": "object",
      "description": "Optional non-PASS checks that are visible but do not degrade operational status",
      "required": ["total", "by_block", "examples"],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer"
        },
        "by_block": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "description": "Detailed check results grouped by block name",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["check", "status"],
          "properties": {
            "check": {
              "type": "string",
              "description": "Unique check identifier (e.g. service:tv-webhook.service)"
            },
            "status": {
              "type": "string",
              "enum": ["PASS", "WARN", "FAIL"]
            },
            "required": {
              "type": "boolean"
            },
            "advisory": {
              "type": "boolean"
            },
            "operational_status": {
              "type": "string",
              "enum": ["PASS", "WARN", "FAIL"]
            },
            "detail": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "elapsed_seconds": {
      "type": "number",
      "description": "Wall-clock seconds the full check run took"
    }
  }
}
