{
  "_description": "TradingView CDP alert templates — P0 SPCX VWAP / ORB / Volume",
  "_mode": "monitor_only",
  "_source": "tradingview_cdp",
  "_route": "data_center.signal_event",
  "_contract": "signal_event.v1",

  "spcx_vwap_reclaim": {
    "source": "tradingview_cdp",
    "contract_class": "signal_event.v1",
    "symbol": "SPCX",
    "timeframe": "5",
    "event": "vwap_reclaim",
    "price": "{{close}}",
    "volume": "{{volume}}",
    "timestamp": "{{timenow}}",
    "flags": {
      "vwap_reclaim": true,
      "orb_break": false,
      "bos": false,
      "choch": false,
      "fvg": false,
      "volume_spike": false
    },
    "risk_mode": "monitor_only",
    "route": "data_center.signal_event"
  },

  "spcx_vwap_loss": {
    "source": "tradingview_cdp",
    "contract_class": "signal_event.v1",
