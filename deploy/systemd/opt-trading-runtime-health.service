[Unit]
Description=Opt Trading Runtime Healthcheck (diagnostic-only)
Documentation=file:///opt/trading/modules/runtime_health/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ghost
Group=ghost
WorkingDirectory=/opt/trading
EnvironmentFile=-/etc/trading/telegram.env
EnvironmentFile=-/etc/trading/runtime.env
EnvironmentFile=-/opt/trading/env/telegram.env
EnvironmentFile=-/opt/trading/env/runtime.env
ExecStart=/opt/trading/scripts/runtime_healthcheck.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ot-runtime-health
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
