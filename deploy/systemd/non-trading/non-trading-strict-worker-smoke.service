[Unit]
Description=Non-Trading: strict worker readonly smoke
Documentation=file:///opt/trading/docs/chantiers/GO_OPT_TRADING_AUTOMATION_NON_TRADING_PERMANENT_ACTIVATION_01/10_ACTIVATION_SCOPE.md

[Service]
Type=oneshot
WorkingDirectory=/opt/trading
ExecStart=/opt/trading/scripts/jobs/strict-worker-readonly-smoke.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nt-strict-smoke
NoNewPrivileges=true

[Install]
WantedBy=default.target
