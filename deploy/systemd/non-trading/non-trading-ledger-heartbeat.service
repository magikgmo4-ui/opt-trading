[Unit]
Description=Non-Trading: ledger heartbeat
Documentation=file:///opt/trading/docs/chantiers/GO_OPT_TRADING_AUTOMATION_NON_TRADING_PERMANENT_ACTIVATION_01/40_KILL_SWITCH_LEDGER_POLICY.md

[Service]
Type=oneshot
WorkingDirectory=/opt/trading
ExecStart=/opt/trading/scripts/jobs/ledger-heartbeat.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nt-ledger-hb
NoNewPrivileges=true

[Install]
WantedBy=default.target
